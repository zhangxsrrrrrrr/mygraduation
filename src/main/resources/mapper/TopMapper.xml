<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="edu.ahau.graduationproject.mapper.TopMapper">
    <update id="updateAnswerTop">
        update answer set flag=1 where answer_Id=#{id}
    </update>
    <select id="selectAnswerFlag" resultType="java.lang.Integer">
        select flag
        from answer where answer_id=#{id};
    </select>
</mapper>